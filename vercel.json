{
  "rewrites": [
    { "source": "/", "destination": "/web/dist/index.html" },
    { "source": "/:path*", "destination": "/web/dist/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}